        RowBox[{"1", "/", 
         RowBox[{"(", 
          RowBox[{"16", "*", 
           RowBox[{"Pi", "^", "2"}]}], ")"}]}], ")"}]}], "*", 
      RowBox[{"Integrate", "[", 
       RowBox[{
        RowBox[{"Log", "[", 
         RowBox[{"1", "+", 
          RowBox[{"x", "*", 
           RowBox[{"(", 
            RowBox[{"1", "-", "x"}], ")"}], "*", 
           RowBox[{
            RowBox[{"P", "^", "2"}], "/", 
            RowBox[{"m", "^", "2"}]}]}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", "0", ",", "1"}], "}"}]}], "]"}]}]}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"dimRegDiff", "=", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{"1", "/", 
         RowBox[{"(", 
          RowBox[{"16", "*", 
           RowBox[{"Pi", "^", "2"}]}], ")"}]}], ")"}]}], "*", 
      RowBox[{"Integrate", "[", 
       RowBox[{
        RowBox[{"Log", "[", 
         RowBox[{"1", "+", 
