Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Unified", " ", "Mathematica", " ", 
    RowBox[{"Script", ":", 
     RowBox[{
      RowBox[{"Complete", " ", "3"}], "-", 
      RowBox[{
      "Part", " ", "Workflow", " ", "in", " ", "Pure", " ", "4", "D", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Limit", " ", "\[Epsilon]"}], "->", 
         RowBox[{"0", " ", "taken", " ", "first"}]}], ")"}]}]}]}]}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{"Using", " ", "direct", " ", "Greek", " ", "notation", " ", 
    RowBox[{"(", 
     RowBox[{
     "\[CapitalLambda]", ",", "\[CapitalOmega]", ",", "\[Pi]", ",", 
      "\[CapitalDelta]", ",", 
      RowBox[{"etc", "."}]}], ")"}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<==================================================\>\"",
      "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<PART 1: Tadpole Integral T with Limit \[Epsilon] -> 0 \
taken first\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<==================================================\>\"",
      "]"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Solid", " ", "angle", " ", "in", " ", "4", " ", 
      RowBox[{"dimensions", ":", 
       RowBox[{"\[CapitalOmega]_", "4"}]}]}], "=", 
     RowBox[{
      RowBox[{"2", "*", 
       RowBox[{
        RowBox[{"\[Pi]", "^", 
         RowBox[{"(", "2", ")"}]}], "/", 
        RowBox[{"Gamma", "[", "2", "]"}]}]}], "=", 
      RowBox[{"2", "*", 
       RowBox[{"\[Pi]", "^", "2"}]}]}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"\[CapitalOmega]4", "=", 
     RowBox[{"2", "*", 
      RowBox[{"\[Pi]", "^", "2"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"measure4", "=", 
     RowBox[{"\[CapitalOmega]4", "/", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"2", "*", "\[Pi]"}], ")"}], "^", "4"}]}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"which", " ", "is", " ", 
     RowBox[{"1", "/", 
      RowBox[{"(", 
       RowBox[{"16", "*", 
        RowBox[{"\[Pi]", "^", "2"}]}], ")"}]}]}], "*)"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "Integral", " ", "for", " ", "T", " ", "in", " ", "4", " ", "dimensions",
       " ", 
      RowBox[{"(", 
       RowBox[{"with", " ", "cutoff", " ", "\[CapitalLambda]"}], ")"}]}], 
     ":"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"T", "=", 
     RowBox[{"measure4", "*", "int_", 
      RowBox[{"0", "^", "\[CapitalLambda]"}], " ", 
      RowBox[{
       RowBox[{"k", "^", "3"}], "/", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"k", "^", "2"}], "+", 
         RowBox[{"m", "^", "2"}]}], ")"}]}], " ", "dk"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rawT", "=", 
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"k", "^", "3"}], "/", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"k", "^", "2"}], "+", 
          RowBox[{"m", "^", "2"}]}], ")"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "0", ",", "\[CapitalLambda]"}], "}"}], ",", 
       RowBox[{"Assumptions", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\[CapitalLambda]", ">", "0"}], ",", 
          RowBox[{"m", ">", "0"}]}], "}"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"exprT", "=", 
     RowBox[{"measure4", "*", "rawT"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Exact T (in 4D limit):\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"FullSimplify", "[", "exprT", "]"}], "]"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"largeLambdaT", "=", 
     RowBox[{"Asymptotic", "[", 
      RowBox[{"exprT", ",", 
       RowBox[{"{", 
        RowBox[{"\[CapitalLambda]", ",", "Infinity", ",", "2"}], "}"}]}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Large \[CapitalLambda] expansion of T:\>\"", "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"FullSimplify", "[", "largeLambdaT", "]"}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", \
"\"\<\\n==================================================\>\"", "]"}], ";"}],
    "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<PART 2: Bubble Integral B(0) with Limit \[Epsilon] -> \
0 taken first\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<==================================================\>\"",
      "]"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Integral", " ", "for", " ", "B", 
      RowBox[{"(", "0", ")"}], " ", "in", " ", "4", " ", "dimensions", " ", 
      RowBox[{"(", 
       RowBox[{"with", " ", "cutoff", " ", "\[CapitalLambda]"}], ")"}]}], 
     ":"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"B", 
      RowBox[{"(", "0", ")"}]}], "=", 
     RowBox[{"measure4", "*", "int_", 
      RowBox[{"0", "^", "\[CapitalLambda]"}], " ", 
      RowBox[{
       RowBox[{"k", "^", "3"}], "/", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"k", "^", "2"}], "+", 
          RowBox[{"m", "^", "2"}]}], ")"}], "^", "2"}]}], " ", "dk"}]}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rawB0", "=", 
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"k", "^", "3"}], "/", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"k", "^", "2"}], "+", 
           RowBox[{"m", "^", "2"}]}], ")"}], "^", "2"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "0", ",", "\[CapitalLambda]"}], "}"}], ",", 
       RowBox[{"Assumptions", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\[CapitalLambda]", ">", "0"}], ",", 
          RowBox[{"m", ">", "0"}]}], "}"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"exprB0", "=", 
     RowBox[{"measure4", "*", "rawB0"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Exact B(0) (in 4D limit):\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"FullSimplify", "[", "exprB0", "]"}], "]"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"largeLambdaB0", "=", 
     RowBox[{"Asymptotic", "[", 
      RowBox[{"exprB0", ",", 
       RowBox[{"{", 
        RowBox[{"\[CapitalLambda]", ",", "Infinity", ",", "2"}], "}"}]}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Large \[CapitalLambda] expansion of B(0):\>\"", "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"FullSimplify", "[", "largeLambdaB0", "]"}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", \
"\"\<\\n==================================================\>\"", "]"}], ";"}],
    "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<PART 3: Verify the Identity -1/(2*m) * \[PartialD]T/\
\[PartialD]m = B(0)\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<==================================================\>\"",
      "]"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"derivativeT", "=", 
     RowBox[{"D", "[", 
      RowBox[{"exprT", ",", "m"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"lhs", "=", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{"1", "/", 
         RowBox[{"(", 
          RowBox[{"2", "*", "m"}], ")"}]}], ")"}]}], "*", "derivativeT"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"simplifiedLHS", "=", 
     RowBox[{"FullSimplify", "[", "lhs", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"simplifiedB0", "=", 
     RowBox[{"FullSimplify", "[", "exprB0", "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"difference", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"simplifiedLHS", "-", "simplifiedB0"}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<LH S (-1/(2*m) * \[PartialD]T/\[PartialD]m): \>\"", ",", 
      "simplifiedLHS"}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<RHS (B(0)):               \>\"", ",", "simplifiedB0"}], 
     "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Difference (LHS - RHS):    \>\"", ",", "difference"}], 
     "]"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"difference", "===", "0"}], ",", 
      RowBox[{
      "Print", "[", "\"\<\\n[CONCLUSION] SUCCESS: -1/(2*m) * \[PartialD]T/\
\[PartialD]m == B(0) holds identically in pure 4D!\>\"", "]"}], ",", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<\\n[CONCLUSION] Note: Difference: \>\"", ",", 
        "difference"}], "]"}]}], "]"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\\n================================================== \
done. ==================================================\>\"", "]"}], 
    ";"}]}]}]], "Input",
