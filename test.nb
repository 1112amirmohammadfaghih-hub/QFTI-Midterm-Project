         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"m", "^", "2"}], ">", "0"}], ",", 
           RowBox[{"P", ">", "0"}]}], "}"}]}]}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"dimRegDiffSimplified", "=", 
