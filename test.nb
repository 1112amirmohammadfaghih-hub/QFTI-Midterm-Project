          RowBox[{"d", "/", "2"}], ")"}]}]}], ")"}], "/", 
      RowBox[{"Gamma", "[", 
       RowBox[{"d", "/", "2"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"measure", "[", "d_", "]"}], ":=", 
