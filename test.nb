      RowBox[{"OmegaD", "[", "d", "]"}], "/", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"2", "*", "Pi"}], ")"}], "^", "d"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"DeltaExpr", "=", 
     RowBox[{
      RowBox[{"m", "^", "2"}], "+", 
      RowBox[{"x", "*", 
       RowBox[{"(", 
        RowBox[{"1", "-", "x"}], ")"}], "*", 
       RowBox[{"P", "^", "2"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"innerB", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"\[CapitalLambda]", "^", "dim"}], "/", 
        RowBox[{"(", 
         RowBox[{"dim", "*", 
          RowBox[{"DeltaExpr", "^", "2"}]}], ")"}]}], ")"}], "*", 
      RowBox[{"Hypergeometric2F1", "[", 
       RowBox[{"2", ",", 
        RowBox[{"dim", "/", "2"}], ",", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"2", "+", "dim"}], ")"}], "/", "2"}], ",", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"\[CapitalLambda]", "^", "2"}]}], "/", "DeltaExpr"}]}], 
       "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rawB", "=", 
     RowBox[{
      RowBox[{"Integrate", "[", 
       RowBox[{"innerB", ",", 
        RowBox[{"{", 
