        "finite", " ", "as", " ", "epsilon"}], "->", 
      RowBox[{"0", ":"}]}]}], "*)"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"B_dim", 
       RowBox[{"(", 
        RowBox[{"P", "^", "2"}], ")"}]}], "-", 
