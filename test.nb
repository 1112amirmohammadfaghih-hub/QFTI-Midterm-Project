   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<B(0) = \>\"", ",", "b0DimReg"}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"2.", " ", "Coupling", " ", "Counterterm", " ", "delta_lambda"}],
      "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"3", "*", 
        RowBox[{
         RowBox[{"lambda", "^", "2"}], "/", "2"}]}], ")"}], "*", "B", 
      RowBox[{"(", "0", ")"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Focusing", " ", "on", " ", "the", " ", 
     RowBox[{"1", "/", "epsilon"}], " ", "pole", " ", "part", " ", "that", " ",
      "cancels", " ", "the", " ", "divergence"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"deltaLambdaPole", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"3", "*", 
        RowBox[{
         RowBox[{"\[Lambda]", "^", "2"}], "/", "2"}]}], ")"}], "*", 
      RowBox[{"(", 
       RowBox[{"1", "/", 
        RowBox[{"(", 
         RowBox[{"16", "*", 
          RowBox[{"Pi", "^", "2"}], "*", "\[Epsilon]"}], ")"}]}], ")"}]}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<delta_lambda (pole) = \>\"", ",", "deltaLambdaPole"}], 
     "]"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"3.", " ", "Scale", " ", "invariance", " ", 
      RowBox[{"condition", ":", 
       RowBox[{"mu", "*", 
        RowBox[{"d", "/", 
