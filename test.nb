      RowBox[{"gives", ":", 
       RowBox[{
        RowBox[{"2", "*", "epsilon", "*", "lambda"}], "+", 
        RowBox[{"beta", 
         RowBox[{"(", "lambda", ")"}]}], "+", 
        RowBox[{"mu", "*", 
         RowBox[{"d", "/", 
          RowBox[{"d_mu", "[", "deltaLambda", "]"}]}]}]}]}]}], "=", "0"}], 
    "*)"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Note", " ", "that", " ", "mu", "*", 
      RowBox[{"d", "/", 
       RowBox[{"d_mu", "[", 
        RowBox[{"Log", 
         RowBox[{"(", 
          RowBox[{"mu", "^", "2"}], ")"}]}], "]"}]}]}], "=", "2"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"dDeltaLambdaDlogMu", "=", 
     RowBox[{"\[Mu]", "*", 
      RowBox[{"D", "[", 
       RowBox[{"deltaLambdaPole", ",", "\[Mu]"}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"Since", " ", "deltaLambdaPole", " ", "contains", " ", 
       RowBox[{"Log", "[", 
        RowBox[{"mu", "^", "2"}], "]"}]}], "=", 
      RowBox[{"2", " ", 
       RowBox[{"Log", "[", "mu", "]"}]}]}], ",", 
     RowBox[{"its", " ", "derivative", " ", 
      RowBox[{"w", ".", "r", ".", "t"}], " ", 
      RowBox[{"Log", "[", "mu", "]"}], " ", "is", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"3", "*", 
         RowBox[{"lambda", "^", "2"}]}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{"16", "*", 
         RowBox[{"Pi", "^", "2"}], "*", "epsilon"}], ")"}]}]}]}], "*)"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Therefore", ",", 
     RowBox[{"the", " ", "equation", " ", "for", " ", "beta", 
