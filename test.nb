        RowBox[{"Assumptions", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\[CapitalLambda]", ">", "0"}], ",", 
           RowBox[{
            RowBox[{"m", "^", "2"}], ">", "0"}], ",", 
           RowBox[{"P", ">", "0"}], ",", 
           RowBox[{"dim", ">", "0"}]}], "}"}]}]}], "]"}], "/.", " ", 
      RowBox[{"D", "->", "dim"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"bCutoff", "=", 
     RowBox[{
