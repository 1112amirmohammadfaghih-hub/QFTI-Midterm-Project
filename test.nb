          RowBox[{"4", "*", "Pi"}], ")"}]}], "-", 
        RowBox[{"Log", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"m", "^", "2"}], "/", 
           RowBox[{"mu", "^", "2"}]}], ")"}]}]}], ")"}]}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\\n[1] Unsubtracted Bubble Integral B(0):\>\"", "]"}], 
