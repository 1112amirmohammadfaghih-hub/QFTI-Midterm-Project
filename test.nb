           RowBox[{"(", 
            RowBox[{"1", "-", "x"}], ")"}], "*", 
           RowBox[{
            RowBox[{"P", "^", "2"}], "/", 
            RowBox[{"m", "^", "2"}]}]}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", "0", ",", "1"}], "}"}], ",", 
