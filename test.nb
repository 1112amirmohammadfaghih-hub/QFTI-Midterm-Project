Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Template", "-", 
    RowBox[{"Aligned", " ", "Two"}], "-", 
    RowBox[{"Loop", " ", "2"}], "-", 
    RowBox[{
    "Point", " ", "Function", " ", "Diagrams", " ", "and", " ", "Amplitudes", 
     " ", "in", " ", "Mathematica"}]}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{
   "Following", " ", "the", " ", "exact", " ", "style", " ", "of", " ", 
    "example", " ", "of", " ", 
    RowBox[{"phi4", ".", "nb"}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"$LoadAddOns", "=", 
     RowBox[{"{", "\"\<FeynArts\>\"", "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Get", "[", "\"\<FeynCalc`\>\"", "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"modelDir", "=", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{
       "$FeynCalcDirectory", ",", "\"\<Examples\>\"", ",", "\"\<Models\>\"", 
        ",", "\"\<Phi4\>\""}], "}"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Model directory: \>\"", ",", "modelDir"}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"FAPatch", "[", 
     RowBox[{
      RowBox[{"PatchModelsOnly", "->", "True"}], ",", 
      RowBox[{"FAModelsDirectory", "->", "modelDir"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<=== Step 1: Generate Two-Loop Two-Point Topologies (1 \
-> 1) ===\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"topologies2Loop", "=", 
     RowBox[{"InsertFields", "[", 
      RowBox[{
       RowBox[{"CreateTopologies", "[", 
        RowBox[{"2", ",", 
         RowBox[{"1", "->", "1"}]}], "]"}], ",", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"S", "[", "1", "]"}], "}"}], "->", 
        RowBox[{"{", 
         RowBox[{"S", "[", "1", "]"}], "}"}]}], ",", 
       RowBox[{"InsertionLevel", "->", 
        RowBox[{"{", "Classes", "}"}]}], ",", 
       RowBox[{"Model", "->", 
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{"modelDir", ",", "\"\<Phi4\>\""}], "}"}], "]"}]}], ",", 
       RowBox[{"GenericModel", "->", 
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{"modelDir", ",", "\"\<Phi4\>\""}], "}"}], "]"}]}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Number of inserted diagrams: \>\"", ",", 
      RowBox[{"Length", "[", "topologies2Loop", "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Paint", "[", 
     RowBox[{"topologies2Loop", ",", 
      RowBox[{"DisplayFunction", "->", "Identity"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<=== Step 2: Create Feynman Amplitudes ===\>\"", "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"fa2Loop", "=", 
     RowBox[{"CreateFeynAmp", "[", 
      RowBox[{"topologies2Loop", ",", 
       RowBox[{"PreFactor", "->", "1"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<=== Step 3: Convert Amplitudes to FeynCalc Format \
===\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"fc2Loop", "=", 
     RowBox[{"FCFAConvert", "[", 
      RowBox[{"fa2Loop", ",", 
       RowBox[{"IncomingMomenta", "->", 
        RowBox[{"{", "p", "}"}]}], ",", 
       RowBox[{"OutgoingMoments", "->", 
        RowBox[{"{", "p", "}"}]}], ",", 
       RowBox[{"LoopMoments", "->", 
        RowBox[{"{", 
         RowBox[{"k1", ",", "k2"}], "}"}]}], ",", 
       RowBox[{"ChangeDimension", "->", "D"}], ",", 
       RowBox[{"List", "->", "False"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Resulting Amplitudes:\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"InputForm", "[", "fc2Loop", "]"}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Export", "[", 
     RowBox[{"\"\<twoloop_twopoint_template_results.m\>\"", ",", "fc2Loop"}], 
     "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Saved template-aligned amplitudes to \
twoloop_twopoint_template_results.m\>\"", "]"}], ";"}]}]}]], "Input",
 CellChangeTimes->{{4.004416951830469*^9, 4.0044169521615276`*^9}, 
   4.004417206586132*^9},
 CellLabel->
  "In[181]:=",ExpressionUUID->"5ebfbd3e-1cb8-914b-868d-8ff9ff04fe06"],

