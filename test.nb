     RowBox[{"B", 
      RowBox[{"(", "0", ")"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Using", " ", "Feynman", " ", "parameters", " ", "and", " ", "momentum", " ",
      "cutoff", " ", "Lambda"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"dim", "=", 
     RowBox[{"4", "-", 
      RowBox[{"2", "*", "epsilon"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"OmegaD", "[", "d_", "]"}], ":=", 
