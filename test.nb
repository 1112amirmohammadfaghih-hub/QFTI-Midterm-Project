   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{
      "Form", " ", "the", " ", "convergent", " ", "difference", " ", "B_cut", 
       RowBox[{"(", 
        RowBox[{"P", "^", "2"}], ")"}]}], "-", 
      RowBox[{"B_cut", 
       RowBox[{"(", "0", ")"}], " ", "BEFORE", " ", "taking", " ", 
