Cell[BoxData["\<\"\\n[1] Unsubtracted Bubble Integral B(0):\"\>"], "Print",
 CellChangeTimes->{4.0044158931975727`*^9, 4.004415929289171*^9},
 CellLabel->
  "During evaluation of \
In[138]:=",ExpressionUUID->"5829f705-ca40-9e4e-a429-be4ee12f65c6"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"B(0) = \"\>", "\[InvisibleSpace]", 
   FractionBox[
    RowBox[{
     FractionBox["1", "epsilon"], "-", "EulerGamma", "-", 
     FractionBox[
      RowBox[{"Log", " ", 
       SuperscriptBox["m", "2"]}], 
      SuperscriptBox["mu", "2"]], "+", 
     RowBox[{"4", " ", "Log", " ", "\[Pi]"}]}], 
    RowBox[{"16", " ", 
     SuperscriptBox["\[Pi]", "2"]}]]}],
  SequenceForm[
  "B(0) = ", Rational[1, 16] 
   Pi^(-2) ($CellContext`epsilon^(-1) - EulerGamma - 
    Log $CellContext`m^2 $CellContext`mu^(-2) + 4 Log Pi)],
  Editable->False]], "Print",
 CellChangeTimes->{4.0044158931975727`*^9, 4.0044159292984467`*^9},
 CellLabel->
  "During evaluation of \
In[138]:=",ExpressionUUID->"200948c2-96cc-104f-8988-3381f4ad56ce"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"delta_lambda (pole) = \"\>", "\[InvisibleSpace]", 
   FractionBox[
    RowBox[{"3", " ", 
     SuperscriptBox["\[Lambda]", "2"]}], 
    RowBox[{"32", " ", 
     SuperscriptBox["\[Pi]", "2"], " ", "\[Epsilon]"}]]}],
  SequenceForm[
  "delta_lambda (pole) = ", Rational[3, 32] 
   Pi^(-2) $CellContext`\[Epsilon]^(-1) $CellContext`\[Lambda]^2],
  Editable->False]], "Print",
 CellChangeTimes->{4.0044158931975727`*^9, 4.0044159292984467`*^9},
 CellLabel->
