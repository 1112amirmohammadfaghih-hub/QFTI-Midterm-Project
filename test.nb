Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Mathematica", " ", 
     RowBox[{"script", ":", 
      RowBox[{
       RowBox[{"Part", " ", "3"}], "-", 
       RowBox[{"Verify", " ", "the", " ", "identity"}], "-", 
       RowBox[{
        RowBox[{"1", "/", 
         RowBox[{"(", 
          RowBox[{"2", "*", "m"}], ")"}]}], "*", 
        RowBox[{
         RowBox[{"\[PartialD]", "T"}], "/", 
         RowBox[{"\[PartialD]", "m"}]}]}]}]}]}], "=", 
    RowBox[{
     RowBox[{"B", 
      RowBox[{"(", "0", ")"}], " ", "using", " ", "analytic", " ", 
      "continuation", " ", "\[Epsilon]"}], "=", 
     RowBox[{"1", "+", "\[Delta]"}]}]}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{"Using", " ", "direct", " ", "Greek", " ", "notation", " ", 
    RowBox[{"(", 
     RowBox[{
     "\[Delta]", ",", "\[Epsilon]", ",", "\[CapitalLambda]", ",", 
      "\[CapitalOmega]", ",", "\[Pi]", ",", 
      RowBox[{"etc", "."}]}], ")"}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"\[Epsilon]", "=", 
     RowBox[{"1", "+", "\[Delta]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"d", "=", 
     RowBox[{"4", "-", 
      RowBox[{"2", "*", "\[Epsilon]"}]}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Spacetime", " ", "dimension", " ", "d"}], "=", 
     RowBox[{"2", "-", 
      RowBox[{"2", "\[Delta]"}]}]}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"\[CapitalOmega]", "[", "dim_", "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"2", "*", 
        RowBox[{"Pi", "^", 
         RowBox[{"(", 
          RowBox[{"dim", "/", "2"}], ")"}]}]}], ")"}], "/", 
      RowBox[{"Gamma", "[", 
       RowBox[{"dim", "/", "2"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"measure", "[", "dim_", "]"}], ":=", 
     RowBox[{
      RowBox[{"\[CapitalOmega]", "[", "dim", "]"}], "/", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"2", "*", "Pi"}], ")"}], "^", "dim"}]}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", \
"\"\<==================================================================\>\"", 
     "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<PART 3: Verify -1/(2*m) * \[PartialD]T/\[PartialD]m = \
B(0) with Analytic Continuation\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", \
"\"\<==================================================================\>\"", 
     "]"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"1.", " ", "Define", " ", "exact", " ", "T", " ", "and", " ", "B", 
     RowBox[{"(", "0", ")"}], " ", "integrals", " ", "with", " ", "cutoff", " ",
      "\[CapitalLambda]"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"rawT", "=", 
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"k", "^", 
         RowBox[{"(", 
          RowBox[{"d", "-", "1"}], ")"}]}], "/", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"k", "^", "2"}], "+", 
          RowBox[{"m", "^", "2"}]}], ")"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "0", ",", "\[CapitalLambda]"}], "}"}], ",", 
       RowBox[{"Assumptions", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\[CapitalLambda]", ">", "0"}], ",", 
          RowBox[{"m", ">", "0"}], ",", 
          RowBox[{"\[Delta]", ">", "0"}], ",", 
          RowBox[{"\[Delta]", "<", "1"}]}], "}"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"exprT", "=", 
     RowBox[{
      RowBox[{"measure", "[", "d", "]"}], "*", "rawT"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rawB0", "=", 
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"k", "^", 
         RowBox[{"(", 
          RowBox[{"d", "-", "1"}], ")"}]}], "/", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"k", "^", "2"}], "+", 
           RowBox[{"m", "^", "2"}]}], ")"}], "^", "2"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "0", ",", "\[CapitalLambda]"}], "}"}], ",", 
       RowBox[{"Assumptions", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\[CapitalLambda]", ">", "0"}], ",", 
          RowBox[{"m", ">", "0"}], ",", 
          RowBox[{"\[Delta]", ">", "0"}], ",", 
          RowBox[{"\[Delta]", "<", "1"}]}], "}"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"exprB0", "=", 
     RowBox[{
      RowBox[{"measure", "[", "d", "]"}], "*", "rawB0"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\\n[Step 1] Computing LHS: -1/(2*m) * \[PartialD]T/\
\[PartialD]m ...\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"derivativeT", "=", 
     RowBox[{"D", "[", 
      RowBox[{"exprT", ",", "m"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"lhs", "=", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{"1", "/", 
         RowBox[{"(", 
          RowBox[{"2", "*", "m"}], ")"}]}], ")"}]}], "*", "derivativeT"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"rhs", "=", "exprB0"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\\n[Step 2] Taking \[CapitalLambda] -> Infinity limit \
for both LHS and RHS (for positive \[Delta])...\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"limitLHS", "=", 
     RowBox[{"Limit", "[", 
      RowBox[{"lhs", ",", 
       RowBox[{"\[CapitalLambda]", "->", "Infinity"}], ",", 
       RowBox[{"Assumptions", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\[Delta]", ">", "0"}], ",", 
          RowBox[{"m", ">", "0"}]}], "}"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"limitRHS", "=", 
     RowBox[{"Limit", "[", 
      RowBox[{"rhs", ",", 
       RowBox[{"\[CapitalLambda]", "->", "Infinity"}], ",", 
       RowBox[{"Assumptions", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\[Delta]", ">", "0"}], ",", 
          RowBox[{"m", ">", "0"}]}], "}"}]}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\\n[Step 3] Expanding both around \[Delta] -> 0 \
...\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"seriesLHS", "=", 
     RowBox[{"Series", "[", 
      RowBox[{"limitLHS", ",", 
       RowBox[{"{", 
        RowBox[{"\[Delta]", ",", "0", ",", "1"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"seriesRHS", "=", 
     RowBox[{"Series", "[", 
      RowBox[{"limitRHS", ",", 
       RowBox[{"{", 
        RowBox[{"\[Delta]", ",", "0", ",", "1"}], "}"}]}], "]"}]}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"normLHS", "=", 
     RowBox[{"Normal", "[", "seriesLHS", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"normRHS", "=", 
     RowBox[{"Normal", "[", "seriesRHS", "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<\\nFinal LHS: \>\"", ",", 
      RowBox[{"FullSimplify", "[", "normLHS", "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Final RHS: \>\"", ",", 
      RowBox[{"FullSimplify", "[", "normRHS", "]"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Step", " ", "4"}], ":", 
     RowBox[{"Compare", " ", "difference"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"difference", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"normLHS", "-", "normRHS"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<\\n[Step 4] Difference (LHS - RHS): \>\"", ",", 
      "difference"}], "]"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", "Conclusion", "*)"}], "\n", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"difference", "===", "0"}], "||", 
       RowBox[{"FullSimplify", "[", 
        RowBox[{"difference", "==", "0"}], "]"}]}], ",", 
      RowBox[{
      "Print", "[", "\"\<\\n[CONCLUSION] SUCCESS: The relation -1/(2*m) * \
\[PartialD]T/\[PartialD]m == B(0) holds identically with analytic \
continuation!\>\"", "]"}], ",", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<\\n[CONCLUSION] Note: Difference evaluated to: \>\"", ",",
         "difference"}], "]"}]}], "]"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", \
"\"\<\\n==================================================================\>\"\
", "]"}], ";"}]}]}]], "Input",
