  RowBox[{"RunProcess", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<C:\\\\Windows\\\\System32\\\\wsl.exe\>\"", ",", "\"\<-e\>\"",
      ",", "\"\<bash\>\"", ",", "\"\<-lc\>\"", 
     ",", "\"\<cd /mnt/f/fire-main/FIRE7 && ./bin/FIRE7 --help\>\""}], "}"}], 
   "]"}], "\[IndentingNewLine]"}]], "Input",
 CellChangeTimes->{{4.004452446091772*^9, 4.004452449450676*^9}},
