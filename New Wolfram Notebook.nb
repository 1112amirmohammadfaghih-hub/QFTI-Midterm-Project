Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"ExitCode\"\>", "\[Rule]", "0"}], ",", 
   RowBox[{"\<\"StandardOutput\"\>", 
    "\[Rule]", "\<\"Usage: ./bin/(FIRE7|FIRE7p|FLAME7|FLAME7p) \
[options]\\n\\t-h, --help                 \\tShow this help.\\n\\t-p, \
--parallel             \\tIndicates that multiple instances of FIRE can be \
called and forces change of database paths\\n\\t-q, --quiet                \
\\tSuppress most of output\\n\\t-Q, --QUIET                \\tSuppress even \
more of output\\n\\t-l <value>, --calc <value> \\tSpecifies siplification \
library (equal to #calc setting) \\n\\t                           \\tPossible \
values are: fermat; maple; math; pari; \\n\\t                           \
\\t(*) - is shipped with FIRE but might require a ./configure option to \
work\\n\\t                           \\t(for example, for libraries such as \
cocoa and ginac not having a built-in prompt we build a wrapper)\\n\\t        \
                   \\tuse --help calc to see the list of default binary paths\
\\n\\t--calc_options <value>     \\tComma-separated options to be passed to \
calc library with fuel::setOption\\n\\t-L <value>, --calc_path \
<value>\\tUser-set path to the library binary, overrides default \
values\\n\\t-c <value>, --config <value>\\tObligatory option, provide path to \
the config file\\n\\t-i <value>, --in <value>   \\tPipe number for writing \
data from the master process\\n\\t-o <value>, --out <value>  \\tPipe number \
for writing data to the master process\\n\\t-s <value>, --sector \
<value>\\tObligatory option for the FLAME process, indicates the sector to \
work in. Negative numbers are used for substitutions\\n\\t-t <value>, \
--thread <value>\\tThread number to print for the FLAME process\\n\\t-b \
<value>, --bucket <value>\\tKyotocabinet bucket setting, overrides config \
value (equal to the #bucket setting)\\n\\t-d <value>, --database \
<value>\\tProvides path to the database folder, overrides config \
value\\n\\t-v <value>, --variables <value>\\tUnderscore_separated_values, \
gives values to variables, in prime mode laste number is used as the number \
of the hardcoded big primes\\n\\t-P <value>, --plan <value> \\tSpecify the \
path to the file with plan.\\n\\t-W <value>, --warmup <value>\\tSpecify the \
path to the file saving warmup information for linear system (Defaults to \
appending .warmup to the plan file).\\n\\t--positive <value>         \
\\tSpecify the positive indices. (equal to #positive)\\n\\t-m, --masters      \
        \\tIf without argument, sets saving only masters, not results. If \
with argument, (number-number) specifies a range of master integrals that are \
to be non-zero (equal to #masters)\\n\\t-a <value>, --printall <value>\\tfor \
debugging, prints integrals involved\\n\\t-O <value>, --output_override \
<value>\\toverrides path to the output table\\n\\t-V, --large_variables      \
\\tVariables passed from arguments can be big and thus external library \
should be used for modular\\n\\t-N, --no_positive_increase \\texperimental, \
try to force to get no positive increase when seeding\\n\\t-I <value>, \
--integrals <value>\\tSpecify the path to the file with input integrals. The \
config file should have the #integrals line without file \
specification\\n\\t--forward                  \\tRun only the forward stage \
(reduction) (equal to #forward)\\n\\t--backward                 \\tRun only \
the backward stage (substitutions) (equal to #backward)\\n\\t-F <value>, \
--folders <value>\\tSpecify whether the Tables should be saved into a \
subfolder depending on passed variables powers\\n\\t--ids_first               \
 \\tchanges tables format putting ids at first place\\n\\t--virtual_in_input  \
       \\tNO EXPLANATION YET!\\n\"\>"}], ",", 
   RowBox[{"\<\"StandardError\"\>", "\[Rule]", "\<\"\"\>"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellChangeTimes->{4.004452450521826*^9},
 CellLabel->"Out[2]=",ExpressionUUID->"c725ddc7-a6d7-d948-9b72-d178aeb5347f"]
}, Open  ]],

