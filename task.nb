    "Print", "[", "\"\<At one-loop order in phi^4 theory, self-energy \
Sigma(p^2) is constant. Hence delta_Z = 0.\>\"", "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", \
"\"\<\\n==================================================\>\"", "]"}], ";"}],
