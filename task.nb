Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Zeroth", "-", 
     RowBox[{"order", " ", 
      RowBox[{"(", 
       RowBox[{"tree", "-", "level"}], ")"}], " ", "1"}]}], "->", 
    RowBox[{"1", " ", "process", " ", 
     RowBox[{"(", 
      RowBox[{"or", " ", "contact"}], ")"}], " ", "diagram"}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"treeTadpole", "=", 
     RowBox[{"InsertFields", "[", 
      RowBox[{
       RowBox[{"CreateTopologies", "[", 
        RowBox[{"0", ",", 
         RowBox[{"1", "->", "1"}]}], "]"}], ",", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"S", "[", "1", "]"}], "}"}], "->", 
        RowBox[{"{", 
         RowBox[{"S", "[", "1", "]"}], "}"}]}], ",", 
       RowBox[{"InsertionLevel", "->", 
        RowBox[{"{", "Classes", "}"}]}], ",", 
       RowBox[{"Model", "->", 
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{"modelDir", ",", "\"\<Phi4\>\""}], "}"}], "]"}]}], ",", 
       RowBox[{"GenericModel", "->", 
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{"modelDir", ",", "\"\<Phi4\>\""}], "}"}], "]"}]}]}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Paint", "[", "treeTadpole", "]"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"faTreeTad", "=", 
     RowBox[{"CreateFeynAmp", "[", 
      RowBox[{"treeTadpole", ",", 
       RowBox[{"PreFactor", "->", "1"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"fcTreeTad", "=", 
     RowBox[{"FCFAConvert", "[", 
      RowBox[{"faTreeTad", ",", 
       RowBox[{"IncomingMomenta", "->", 
        RowBox[{"{", "p1", "}"}]}], ",", 
       RowBox[{"OutgoingMomenta", "->", 
        RowBox[{"{", "k1", "}"}]}], ",", 
       RowBox[{"List", "->", "False"}]}], "]"}]}], ";"}], "\n", "fcTreeTad", 
   "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"First", "-", 
     RowBox[{"order", " ", 
      RowBox[{"(", 
       RowBox[{"one", "-", "loop"}], ")"}], " ", "tadpole", " ", 
      "diagram"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tadpole", "=", 
     RowBox[{"InsertFields", "[", 
      RowBox[{
       RowBox[{"CreateTopologies", "[", 
        RowBox[{"1", ",", 
         RowBox[{"1", "->", "1"}]}], "]"}], ",", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"S", "[", "1", "]"}], "}"}], "->", 
        RowBox[{"{", 
         RowBox[{"S", "[", "1", "]"}], "}"}]}], ",", 
       RowBox[{"InsertionLevel", "->", 
        RowBox[{"{", "Classes", "}"}]}], ",", 
       RowBox[{"Model", "->", 
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{"modelDir", ",", "\"\<Phi4\>\""}], "}"}], "]"}]}], ",", 
       RowBox[{"GenericModel", "->", 
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{"modelDir", ",", "\"\<Phi4\>\""}], "}"}], "]"}]}]}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Paint", "[", "tadpole", "]"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"faTad", "=", 
     RowBox[{"CreateFeynAmp", "[", 
      RowBox[{"tadpole", ",", 
       RowBox[{"PreFactor", "->", "1"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"fcTad", "=", 
     RowBox[{"FCFAConvert", "[", 
      RowBox[{"faTad", ",", 
       RowBox[{"IncomingMomenta", "->", 
        RowBox[{"{", "p1", "}"}]}], ",", 
       RowBox[{"OutgoingMomenta", "->", 
        RowBox[{"{", "k1", "}"}]}], ",", 
       RowBox[{"LoopMomenta", "->", 
        RowBox[{"{", "q", "}"}]}], ",", 
       RowBox[{"ChangeDimension", "->", "D"}], ",", 
       RowBox[{"List", "->", "False"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"tadPV", "=", 
     RowBox[{"ToPaVe", "[", 
      RowBox[{
       RowBox[{"fcTad", "/.", " ", 
        RowBox[{"mphi", "->", "m"}]}], ",", "q"}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"uvTad", "=", 
     RowBox[{"PaVeUVPart", "[", 
      RowBox[{"tadPV", ",", 
       RowBox[{"Prefactor", "->", 
        RowBox[{"1", "/", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"2", " ", "Pi"}], ")"}], "^", "D"}]}]}]}], "]"}]}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"seriesOrderZero", "=", 
     RowBox[{"Series", "[", 
      RowBox[{
       RowBox[{"uvTad", "/.", " ", 
        RowBox[{"D", "->", 
         RowBox[{"4", "-", 
          RowBox[{"2", " ", "eps"}]}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"eps", ",", "0", ",", "0"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"seriesOrderOne", "=", 
     RowBox[{"Series", "[", 
      RowBox[{
       RowBox[{"uvTad", "/.", " ", 
        RowBox[{"D", "->", 
         RowBox[{"4", "-", 
          RowBox[{"2", " ", "eps"}]}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"eps", ",", "0", ",", "1"}], "}"}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"seriesOrderZero", ",", "seriesOrderOne"}], "}"}]}]}]], "Input",
 CellChangeTimes->{{4.004231904049711*^9, 4.004231904049711*^9}},
 CellLabel->"In[6]:=",ExpressionUUID->"ed19ce2a-9d6f-d746-b95a-432bde34000a"],

