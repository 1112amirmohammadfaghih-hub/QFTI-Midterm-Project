Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Load", " ", "FeynArts", " ", "and", " ", "FeynCalc"}], ",", 
    RowBox[{
    "and", " ", "set", " ", "up", " ", "the", " ", "Phi4", " ", "model", " ", 
     "directory"}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"$LoadAddOns", "=", 
     RowBox[{"{", "\"\<FeynArts\>\"", "}"}]}], ";"}], "\n", 
   RowBox[{"<<", "FeynCalc`"}], "\n", 
   RowBox[{
    RowBox[{"modelDir", "=", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{
       "$FeynCalcDirectory", ",", "\"\<Examples\>\"", ",", "\"\<Models\>\"", 
        ",", "\"\<Phi4\>\""}], "}"}], "]"}]}], ";"}], "\n", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"FileExistsQ", "[", 
      RowBox[{"FileNameJoin", "[", 
       RowBox[{"{", 
        RowBox[{"modelDir", ",", "\"\<Phi4.mod\>\""}], "}"}], "]"}], "]"}], ",", 
     RowBox[{"FileExistsQ", "[", 
      RowBox[{"FileNameJoin", "[", 
       RowBox[{"{", 
        RowBox[{"modelDir", ",", "\"\<Phi4.gen\>\""}], "}"}], "]"}], "]"}]}], 
    "}"}], "\n", 
   RowBox[{
    RowBox[{"FAPatch", "[", 
     RowBox[{
      RowBox[{"PatchModelsOnly", "->", "True"}], ",", 
      RowBox[{"FAModelsDirectory", "->", "modelDir"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"===", 
     RowBox[{"4", "-", 
      RowBox[{"POINT", " ", 
       RowBox[{"FUNCTION", ":", 
        RowBox[{
         RowBox[{"Tree", " ", "Level", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"0", "-", "loop"}], ",", 
            RowBox[{"2", "->", 
             RowBox[{"2", " ", "scattering"}]}]}], ")"}]}], "==="}]}]}]}]}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tree", "=", 
     RowBox[{"InsertFields", "[", 
      RowBox[{
       RowBox[{"CreateTopologies", "[", 
        RowBox[{"0", ",", 
         RowBox[{"2", "->", "2"}]}], "]"}], ",", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"S", "[", "1", "]"}], ",", 
          RowBox[{"S", "[", "1", "]"}]}], "}"}], "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"S", "[", "1", "]"}], ",", 
          RowBox[{"S", "[", "1", "]"}]}], "}"}]}], ",", 
       RowBox[{"InsertionLevel", "->", 
        RowBox[{"{", "Classes", "}"}]}], ",", 
       RowBox[{"Model", "->", 
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{"modelDir", ",", "\"\<Phi4\>\""}], "}"}], "]"}]}], ",", 
       RowBox[{"GenericModel", "->", 
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{"modelDir", ",", "\"\<Phi4\>\""}], "}"}], "]"}]}]}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Paint", "[", "tree", "]"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"faTree", "=", 
     RowBox[{"CreateFeynAmp", "[", 
      RowBox[{"tree", ",", 
       RowBox[{"PreFactor", "->", "1"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"fcTree", "=", 
     RowBox[{"FCFAConvert", "[", 
      RowBox[{"faTree", ",", 
       RowBox[{"IncomingMomenta", "->", 
        RowBox[{"{", 
         RowBox[{"p1", ",", "p2"}], "}"}]}], ",", 
       RowBox[{"OutgoingMomenta", "->", 
        RowBox[{"{", 
         RowBox[{"k1", ",", "k2"}], "}"}]}], ",", 
       RowBox[{"List", "->", "False"}]}], "]"}]}], ";"}], "\n", "fcTree", 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"===", 
     RowBox[{"4", "-", 
      RowBox[{"POINT", " ", 
       RowBox[{"FUNCTION", ":", 
        RowBox[{
         RowBox[{"One", "-", 
          RowBox[{"Loop", " ", 
           RowBox[{"(", 
            RowBox[{"Bubbles", ",", 
             RowBox[{
              RowBox[{"excluding", " ", "wave"}], "-", 
              RowBox[{"function", " ", "corrections"}]}]}], ")"}]}]}], 
         "==="}]}]}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"bubbles", "=", 
     RowBox[{"InsertFields", "[", 
      RowBox[{
       RowBox[{"CreateTopologies", "[", 
        RowBox[{"1", ",", 
         RowBox[{"2", "->", "2"}], ",", 
         RowBox[{"ExcludeTopologies", "->", 
          RowBox[{"{", "WFCorrections", "}"}]}]}], "]"}], ",", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"S", "[", "1", "]"}], ",", 
          RowBox[{"S", "[", "1", "]"}]}], "}"}], "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"S", "[", "1", "]"}], ",", 
          RowBox[{"S", "[", "1", "]"}]}], "}"}]}], ",", 
       RowBox[{"InsertionLevel", "->", 
        RowBox[{"{", "Classes", "}"}]}], ",", 
       RowBox[{"Model", "->", 
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{"modelDir", ",", "\"\<Phi4\>\""}], "}"}], "]"}]}], ",", 
       RowBox[{"GenericModel", "->", 
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{"modelDir", ",", "\"\<Phi4\>\""}], "}"}], "]"}]}]}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Paint", "[", "bubbles", "]"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"faLoop", "=", 
     RowBox[{"CreateFeynAmp", "[", 
      RowBox[{"bubbles", ",", 
       RowBox[{"PreFactor", "->", "1"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"fcLoop", "=", 
     RowBox[{"FCFAConvert", "[", 
      RowBox[{"faLoop", ",", 
       RowBox[{"IncomingMomenta", "->", 
        RowBox[{"{", 
         RowBox[{"p1", ",", "p2"}], "}"}]}], ",", 
       RowBox[{"OutgoingMomenta", "->", 
        RowBox[{"{", 
         RowBox[{"k1", ",", "k2"}], "}"}]}], ",", 
       RowBox[{"LoopMomenta", "->", 
        RowBox[{"{", "q", "}"}]}], ",", 
       RowBox[{"ChangeDimension", "->", "D"}], ",", 
       RowBox[{"List", "->", "False"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"bubblePV", "=", 
     RowBox[{"ToPaVe", "[", 
      RowBox[{
       RowBox[{"fcLoop", "/.", " ", 
        RowBox[{"mphi", "->", "m"}]}], ",", "q"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"uvBubble", "=", 
     RowBox[{"PaVeUVPart", "[", 
      RowBox[{"bubblePV", ",", 
       RowBox[{"Prefactor", "->", 
        RowBox[{"1", "/", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"2", " ", "Pi"}], ")"}], "^", "D"}]}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"seriesOrderZeroBubble", "=", 
     RowBox[{"Series", "[", 
      RowBox[{
       RowBox[{"uvBubble", "/.", " ", 
        RowBox[{"D", "->", 
         RowBox[{"4", "-", 
          RowBox[{"2", " ", "eps"}]}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"eps", ",", "0", ",", "0"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"seriesOrderOneBubble", "=", 
     RowBox[{"Series", "[", 
      RowBox[{
       RowBox[{"uvBubble", "/.", " ", 
        RowBox[{"D", "->", 
         RowBox[{"4", "-", 
          RowBox[{"2", " ", "eps"}]}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"eps", ",", "0", ",", "1"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"{", 
    RowBox[{"seriesOrderZeroBubble", ",", "seriesOrderOneBubble"}], 
    "}"}]}]}]], "Input",
