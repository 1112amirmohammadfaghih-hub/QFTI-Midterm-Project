Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"Step", " ", "1"}], ":", 
     RowBox[{"Load", " ", "FeynArts", " ", "and", " ", "FeynCalc"}]}], ",", 
    RowBox[{
    "and", " ", "set", " ", "up", " ", "the", " ", "Phi4", " ", "model", " ", 
     "directory"}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"$LoadAddOns", "=", 
