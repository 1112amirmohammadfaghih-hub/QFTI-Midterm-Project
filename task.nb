Cell[BoxData[
 FormBox[
  RowBox[{"\n", 
   RowBox[{
    RowBox[{
     RowBox[{"topologies", " ", "=", " ", 
      RowBox[{"CreateTopologies", "[", 
       RowBox[{"2", ",", " ", 
        RowBox[{"2", " ", "->", " ", "2"}], ",", " ", 
        RowBox[{"InsertionLevel", " ", "->", " ", 
         RowBox[{"{", "Particles", "}"}]}]}], "]"}]}], ";"}], "\n", 
    RowBox[{
     RowBox[{"inserted", " ", "=", " ", 
      RowBox[{"InsertFields", "[", 
       RowBox[{"topologies", ",", " ", 
        RowBox[{
         RowBox[{"S", "[", "1", "]"}], " ", "->", " ", 
         RowBox[{"S", "[", "1", "]"}]}], ",", " ", 
        RowBox[{"Model", " ", "->", " ", "\<\"SM\"\>"}], ",", " ", 
        RowBox[{"GenericModel", " ", "->", " ", "\<\"Lorentz\"\>"}]}], 
       "]"}]}], ";"}], "\n", 
    RowBox[{
     RowBox[{"Paint", "[", 
      RowBox[{"inserted", ",", " ", 
       RowBox[{"ColumnsXRows", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "2"}], "}"}]}], ",", " ", 
       RowBox[{"Numbering", " ", "->", " ", "Simple"}]}], "]"}], ";"}], "\n", 
    RowBox[{
     RowBox[{"amp", " ", "=", " ", 
      RowBox[{"CreateFeynAmp", "[", "inserted", "]"}]}], ";"}], "\n", 
    RowBox[{
     RowBox[{"fcfa", " ", "=", " ", 
      RowBox[{"FCFAConvert", "[", 
       RowBox[{"amp", ",", " ", 
        RowBox[{"IncomingMoments", " ", "->", " ", 
         RowBox[{"{", "p", "}"}]}], ",", " ", 
        RowBox[{"OutgoingMoments", " ", "->", " ", 
         RowBox[{"{", "p", "}"}]}], ",", " ", 
        RowBox[{"LoopMoments", " ", "->", " ", 
         RowBox[{"{", 
