        RowBox[{"modelDir", ",", "\"\<Phi4.mod\>\""}], "}"}], "]"}], "]"}], ",", 
     RowBox[{"FileExistsQ", "[", 
      RowBox[{"FileNameJoin", "[", 
       RowBox[{"{", 
        RowBox[{"modelDir", ",", "\"\<Phi4.gen\>\""}], "}"}], "]"}], "]"}]}], 
    "}"}], "\n", 
   RowBox[{
    RowBox[{"FAPatch", "[", 
     RowBox[{
      RowBox[{"PatchModelsOnly", "->", "True"}], ",", 
      RowBox[{"FAModelsDirectory", "->", "modelDir"}]}], "]"}], ";"}], "\n", 
   "\[IndentingNewLine]"}]}]], "Input",
