Cell[BoxData[
 FormBox["\<\"Gamma-function expression H(p^2):\"\>", 
  TraditionalForm]], "Print",
 CellChangeTimes->{4.004309580343319*^9},
 CellLabel->
  "During evaluation of \
In[175]:=",ExpressionUUID->"42b17440-1604-3c46-b283-33893c680042"],

Cell[BoxData[
 FormBox[
  RowBox[{
   FractionBox["1", 
    TemplateBox[{
      RowBox[{"1", "-", 
        RowBox[{"2", " ", "epsilon"}]}]},
     "Gamma"]], 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"4", " ", "\[Pi]"}], ")"}], 
    RowBox[{"2", " ", 
     RowBox[{"(", 
      RowBox[{"epsilon", "-", "2"}], ")"}]}]], " ", 
   SuperscriptBox[
    RowBox[{"(", 
     SuperscriptBox["p", "2"], ")"}], 
    RowBox[{"1", "-", 
     RowBox[{"2", " ", "epsilon"}]}]], " ", 
   SuperscriptBox[
    TemplateBox[{
      RowBox[{"1", "-", "epsilon"}]},
     "Gamma"], "3"], " ", 
   TemplateBox[{"epsilon"},
    "Gamma"], " ", 
   TemplateBox[{
     RowBox[{"epsilon", "+", "1"}]},
    "Gamma"]}], TraditionalForm]], "Print",
 CellChangeTimes->{4.0043095804529896`*^9},
 CellLabel->
  "During evaluation of \
In[175]:=",ExpressionUUID->"dd398ea2-da37-9242-88ff-70039a847c15"],

Cell[BoxData[
 FormBox["\<\"\\nLaurent expansion of H(p^2):\"\>", TraditionalForm]], "Print",
 CellChangeTimes->{4.004309580515932*^9},
 CellLabel->
  "During evaluation of \
In[175]:=",ExpressionUUID->"8035414b-f41b-9146-bac4-449e13a8d96b"],

Cell[BoxData[
 FormBox[
  RowBox[{"-", 
   FractionBox[
    RowBox[{
     SuperscriptBox["p", "2"], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"2", " ", "epsilon", " ", 
        RowBox[{"log", "(", 
         SuperscriptBox["p", "2"], ")"}]}], "+", 
       RowBox[{"epsilon", " ", 
        RowBox[{"(", 
         RowBox[{
          TagBox["\[DoubledGamma]",
           Function[{}, EulerGamma]], "-", 
          RowBox[{"2", " ", 
           RowBox[{"log", "(", 
            RowBox[{"4", " ", "\[Pi]"}], ")"}]}]}], ")"}]}], "-", "1"}], 
      ")"}]}], 
    RowBox[{"256", " ", 
     SuperscriptBox["\[Pi]", "4"], " ", "epsilon"}]]}], 
  TraditionalForm]], "Print",
 CellChangeTimes->{4.004309580626932*^9},
 CellLabel->
