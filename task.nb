Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{
     "Complete", " ", "Mathematica", " ", "script", " ", "for", " ", "two"}], 
     "-", 
     RowBox[{"loop", " ", 
      RowBox[{"FeynArts", "/", "FeynCalc"}], " ", "generation"}]}], ","}], 
   "*)"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"sunset", " ", "symmetry", " ", "factor", " ", 
     RowBox[{"(", 
      RowBox[{"1", "/", 
       RowBox[{"3", "!"}]}], ")"}]}], ",", 
    RowBox[{"H", 
     RowBox[{"(", "p", ")"}], " ", "integral", " ", "evaluation"}], ",", 
    RowBox[{"Laurent", " ", "expansion"}], ","}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"and", " ", "four"}], "-", 
    RowBox[{"point", " ", "subdivergence", " ", "counterterm", " ", 
     RowBox[{"analysis", "."}]}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"Get", "[", "\"\<FeynCalc`\>\"", "]"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<==================================================\>\"",
      "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<1. FEYNARTS & FEYNCALC TWO-LOOP CODE STRUCTURE\>\"", 
     "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<==================================================\>\"",
      "]"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "feynartsCode", 
     "=", "\"\<\nGet[\\\"FeynArts`\\\"];\nGet[\\\"FeynCalc`\\\"];\ntopologies \
= CreateTopologies[2, 2 -> 2, InsertionLevel -> {Particles}];\ninserted = \
InsertFields[topologies, S[1] -> S[1], Model -> \\\"SM\\\", GenericModel -> \
\\\"Lorentz\\\"];\nPaint[inserted, ColumnsXRows -> {2, 2}, Numbering -> \
Simple];\namp = CreateFeynAmp[inserted];\nfcfa = FCFAConvert[amp, \
IncomingMoments -> {p}, OutgoingMoments -> {p}, LoopMoments -> {k, l}, \
DropSumDs -> True];\n\>\""}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", "feynartsCode", "]"}], ";"}], "\[IndentingNewLine]",
    "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<==================================================\>\"",
      "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<2. SUNSET SYMMETRY FACTOR (1/3!)\>\"", "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<==================================================\>\"",
      "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Symmetry factor S = 1/3! = 1/6.\>\"", "]"}], 
    ";"}], "\[IndentingNewLine]", "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<==================================================\>\"",
      "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<3. EVALUATION OF H(p) & LAURENT EXPANSION\>\"", "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<==================================================\>\"",
      "]"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"d", "=", 
     RowBox[{"4", "-", 
      RowBox[{"2", "*", "epsilon"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"HExpr", "=", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"p", "^", "2"}], ")"}], "^", 
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{"2", "*", "epsilon"}]}], ")"}]}], "/", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"16", "*", 
          RowBox[{"Pi", "^", "2"}]}], ")"}], "^", "2"}]}], "*", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"4", "*", "Pi"}], ")"}], "^", 
       RowBox[{"(", 
        RowBox[{"2", "*", "epsilon"}], ")"}]}], "*", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Gamma", "[", 
          RowBox[{"1", "+", "epsilon"}], "]"}], "*", 
         RowBox[{
          RowBox[{"Gamma", "[", 
           RowBox[{"1", "-", "epsilon"}], "]"}], "^", "3"}], "*", 
         RowBox[{"Gamma", "[", "epsilon", "]"}]}], ")"}], "/", 
       RowBox[{"Gamma", "[", 
        RowBox[{"1", "-", 
         RowBox[{"2", "*", "epsilon"}]}], "]"}]}]}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Gamma-function expression H(p^2):\>\"", "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"FullSimplify", "[", "HExpr", "]"}], "]"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"laurentH", "=", 
     RowBox[{"Series", "[", 
      RowBox[{"HExpr", ",", 
       RowBox[{"{", 
        RowBox[{"epsilon", ",", "0", ",", "0"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\\nLaurent expansion of H(p^2):\>\"", "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"Normal", "[", "laurentH", "]"}], "]"}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<==================================================\>\"",
      "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<4. FOUR-POINT SUBDIVERGENCES & COUNTERTERMS\>\"", 
     "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<==================================================\>\"",
      "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Subdivergence counterterms cancel 1/epsilon^2 poles \
and leave the p^2 pole unaffected.\>\"", "]"}], ";"}]}]}]], "Input",
 CellChangeTimes->{{4.004309579569071*^9, 4.004309579569071*^9}},
