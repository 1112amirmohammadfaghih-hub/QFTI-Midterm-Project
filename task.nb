   RowBox[{
    RowBox[{
    "Print", "[", "\"\<==================================================\>\"",
      "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"beta", "[", 
      RowBox[{"g_", ",", "epsilon_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "epsilon"}], "*", "g"}], "+", 
      RowBox[{"3", "*", 
       RowBox[{"g", "^", "2"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"fixedPoint", "=", 
     RowBox[{
      RowBox[{"Solve", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"beta", "[", 
           RowBox[{"g", ",", "epsilon"}], "]"}], "==", "0"}], "&&", 
         RowBox[{"g", "!=", "0"}]}], ",", "g"}], "]"}], "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Nonzero fixed point g^*: \>\"", ",", "fixedPoint"}], "]"}], 
    ";"}], "\[IndentingNewLine]", "\n", 
