Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"dim", "=", 
   RowBox[{"4", "-", 
    RowBox[{"2", "*", "\[Epsilon]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"OmegaD", "[", "d_", "]"}], ":=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"2", "*", 
       RowBox[{"Pi", "^", 
        RowBox[{"(", 
         RowBox[{"d", "/", "2"}], ")"}]}]}], ")"}], "/", 
     RowBox[{"Gamma", "[", 
      RowBox[{"d", "/", "2"}], "]"}]}]}], ";"}], "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Radial", " ", 
    RowBox[{"integral", ":", 
     RowBox[{"int_", 
      RowBox[{"0", "^", "Lambda"}], " ", 
      RowBox[{
       RowBox[{"k", "^", 
        RowBox[{"(", 
         RowBox[{"dim", "-", "1"}], ")"}]}], "/", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"k", "^", "2"}], "+", 
         RowBox[{"m", "^", "2"}]}], ")"}]}], " ", "dk"}]}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"rawVal", "=", 
    RowBox[{
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"k", "^", 
         RowBox[{"(", 
          RowBox[{"dim", "-", "1"}], ")"}]}], "/", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"k", "^", "2"}], "+", 
          RowBox[{"m", "^", "2"}]}], ")"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "0", ",", "\[CapitalLambda]"}], "}"}], ",", 
       RowBox[{"Assumptions", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\[CapitalLambda]", ">", "0"}], ",", 
          RowBox[{
           RowBox[{"m", "^", "2"}], ">", "0"}]}], "}"}]}]}], "]"}], "/.", " ", 
     RowBox[{"D", "->", "dim"}]}]}], ";"}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{"1.", " ", "Exact", " ", "T", " ", "without", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"2", "pi"}], ")"}], "^", "D"}], " ", "prefactor", " ", 
    RowBox[{"(", 
     RowBox[{"using", " ", "solid", " ", "angle", " ", "Omega_D"}], ")"}]}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"exactT1", "=", 
   RowBox[{
    RowBox[{"OmegaD", "[", "dim", "]"}], "*", "rawVal"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<--- 1. Exact T (without (2pi)^D) ---\>\"", "]"}],
   ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", "exactT1", "]"}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"asympT1", "=", 
   RowBox[{"Asymptotic", "[", 
    RowBox[{"exactT1", ",", 
     RowBox[{"{", 
      RowBox[{"\[CapitalLambda]", ",", "Infinity", ",", "2"}], "}"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<Expanded in large Lambda:\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{"FullSimplify", "[", "asympT1", "]"}], "]"}], ";"}], "\n", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"2.", " ", "Exact", " ", "T", " ", "divided", " ", "by", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"2", "pi"}], ")"}], "^", "D"}], " ", 
    RowBox[{"(", 
     RowBox[{"Standard", " ", "QFT", " ", "loop", " ", "measure"}], ")"}]}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"exactT2", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "/", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"2", "*", "Pi"}], ")"}], "^", "dim"}]}], ")"}], "*", 
    "exactT1"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<--- 2. Exact T / (2pi)^D ---\>\"", "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", "exactT2", "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"asympT2", "=", 
   RowBox[{"Asymptotic", "[", 
    RowBox[{"exactT2", ",", 
     RowBox[{"{", 
      RowBox[{"\[CapitalLambda]", ",", "Infinity", ",", "2"}], "}"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<Expanded in large Lambda:\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"FullSimplify", "[", "asympT2", "]"}], "]"}], ";"}]}], "Input",
