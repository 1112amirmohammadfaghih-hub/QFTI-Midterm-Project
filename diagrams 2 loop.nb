    "Print", "[", "\"\<- Fixed point g* is of order \[Epsilon] (g* ~ \
\[Epsilon]).\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<- \[Gamma]_\[Phi] starts at order g^2 ~ \
\[Epsilon]^2.\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<- Substituting 1-loop g* into 2-loop \[Gamma]_\[Phi] \
yields \[Eta] accurate through \[Epsilon]^2;\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<  higher-loop corrections to g* contribute at \
\[Epsilon]^3 and vanish at this order.\>\"", "]"}], ";"}], 
   "\[IndentingNewLine]"}]}]], "Input",
