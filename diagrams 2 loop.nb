Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"===", 
    RowBox[{"==", 
     RowBox[{
      RowBox[{"01", " ", "Draw", " ", "the", " ", "two"}], "-", 
      RowBox[{"loop", " ", "2"}], "-", 
      RowBox[{"point", " ", "function", " ", "diagrams", " ", 
       RowBox[{"(", 
        RowBox[{"tadpole", "-", 
         RowBox[{
          RowBox[{"like", "/", "sunset"}], " ", "self"}], "-", 
         RowBox[{"energy", " ", "corrections"}]}], ")"}]}]}]}], "===", "=="}],
    "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"twopoint2loop", "=", 
     RowBox[{"InsertFields", "[", 
      RowBox[{
       RowBox[{"CreateTopologies", "[", 
        RowBox[{"2", ",", 
         RowBox[{"1", "->", "1"}]}], "]"}], ",", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"S", "[", "1", "]"}], "}"}], "->", 
        RowBox[{"{", 
         RowBox[{"S", "[", "1", "]"}], "}"}]}], ",", 
       RowBox[{"InsertionLevel", "->", 
        RowBox[{"{", "Classes", "}"}]}], ",", 
       RowBox[{"Model", "->", 
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{"modelDir", ",", "\"\<Phi4\>\""}], "}"}], "]"}]}], ",", 
       RowBox[{"GenericModel", "->", 
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{"modelDir", ",", "\"\<Phi4\>\""}], "}"}], "]"}]}]}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{"Paint", "[", "twopoint2loop", "]"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"===", 
     RowBox[{"==", 
      RowBox[{
       RowBox[{"02", " ", "Convert", " ", "the", " ", "2"}], "-", 
       RowBox[{"loop", " ", "2"}], "-", 
       RowBox[{"point", " ", "amplitude"}]}]}], "===", "=="}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"faloop2point", "=", 
     RowBox[{"CreateFeynAmp", "[", 
      RowBox[{"twopoint2loop", ",", 
       RowBox[{"PreFactor", "->", "1"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"fcloop2point", "=", 
     RowBox[{"FCFAConvert", "[", 
      RowBox[{"faloop2point", ",", 
       RowBox[{"IncomingMomenta", "->", 
        RowBox[{"{", "P", "}"}]}], ",", 
       RowBox[{"OutgoingMomenta", "->", 
        RowBox[{"{", "P", "}"}]}], ",", 
       RowBox[{"LoopMomenta", "->", 
        RowBox[{"{", 
         RowBox[{
          SubscriptBox["q", "1"], ",", 
          SubscriptBox["q", "2"]}], "}"}]}], ",", 
       RowBox[{"ChangeDimension", "->", "D"}], ",", 
       RowBox[{"List", "->", "False"}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"===", 
     RowBox[{"==", 
      RowBox[{
      "03", " ", "Find", " ", "the", " ", "UV", " ", "pole", " ", "and", " ", 
       "perform", " ", "the", " ", "epsilon", " ", "series", " ", 
       "expansion"}]}], "===", "=="}], "*)"}], "\n", 
   RowBox[{"loop2pointPV", "=", 
    RowBox[{"ToPaVe", "[", 
     RowBox[{
      RowBox[{"fcloop2point", "/.", " ", 
       RowBox[{"mphi", "->", "m"}]}], ",", "P"}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"uv2loop2point", "=", " ", 
     RowBox[{"PaVeUVPart", "[", 
      RowBox[{"loop2pointPV", ",", 
       RowBox[{"Prefactor", "->", 
        RowBox[{"1", "/", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"2", " ", "Pi"}], ")"}], "^", "D"}]}]}]}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{"Series", "[", 
    RowBox[{
     RowBox[{"uv2loop2point", "/.", " ", 
      RowBox[{"D", "->", 
       RowBox[{"4", "-", 
        RowBox[{"2", " ", "\[Epsilon]"}]}]}]}], ",", 
     RowBox[{"{", 
      RowBox[{"\[Epsilon]", ",", "0", ",", "0"}], "}"}]}], " ", 
    "]"}]}]}]], "Input",
