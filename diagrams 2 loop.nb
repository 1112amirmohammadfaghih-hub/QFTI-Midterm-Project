        RowBox[{"1", "/", "12"}], ")"}], "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"\[Lambda]", "^", "2"}], ")"}], "/", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"16", "*", 
            RowBox[{"Pi", "^", "2"}]}], ")"}], "^", "2"}]}], ")"}], "*", 
       RowBox[{"(", 
        RowBox[{"1", "/", "\[Epsilon]"}], ")"}]}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Wave-function renormalization Z_\[Phi]:\>\"", "]"}], 
