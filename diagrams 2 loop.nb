   RowBox[{
    RowBox[{
    "Print", "[", "\"\<==================================================\>\"",
      "]"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Wave", "-", 
     RowBox[{
     "function", " ", "renormalization", " ", "constant", " ", "Z_\[Phi]", " ",
       "up", " ", "to", " ", "two", " ", "loops", " ", 
      RowBox[{"(", 
       RowBox[{"O", 
        RowBox[{"(", 
         RowBox[{"\[Lambda]", "^", "2"}], ")"}]}], ")"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ZPhi", "=", 
     RowBox[{"1", "+", 
      RowBox[{
