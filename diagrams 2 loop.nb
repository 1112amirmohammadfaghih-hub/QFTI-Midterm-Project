Cell[BoxData[
 FormBox[
  InterpretationBox[
   StyleBox[
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"\[Lambda]", "^", "2"}], "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"3", "*", 
            RowBox[{"m", "^", "2"}]}], ")"}], "/", 
          RowBox[{"\[Epsilon]", "^", "2"}]}], " ", "+", " ", 
         RowBox[{"FinitePartH", "[", 
          RowBox[{
           RowBox[{"p", "^", "2"}], ",", " ", 
           RowBox[{"m", "^", "2"}]}], "]"}], " ", "+", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"4", "*", 
             RowBox[{"m", "^", "2"}]}], " ", "-", " ", 
            RowBox[{
             RowBox[{"p", "^", "2"}], "/", "2"}], " ", "+", " ", 
            RowBox[{"3", "*", 
             RowBox[{"m", "^", "2"}], "*", 
             RowBox[{"Log", "[", 
              RowBox[{
               RowBox[{"m", "^", "2"}], "/", 
               RowBox[{"mu", "^", "2"}]}], "]"}]}]}], ")"}], "/", 
          "\[Epsilon]"}]}], ")"}]}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{"1536", "*", 
       RowBox[{"Pi", "^", "4"}]}], ")"}]}],
    ShowStringCharacters->True,
    NumberMarks->True],
   InputForm[
   Rational[1, 1536] 
    Pi^(-4) $CellContext`\[Lambda]^2 (
     3 $CellContext`m^2 $CellContext`\[Epsilon]^(-2) + \
$CellContext`FinitePartH[$CellContext`p^2, $CellContext`m^2] + $CellContext`\
\[Epsilon]^(-1) (4 $CellContext`m^2 + Rational[-1, 2] $CellContext`p^2 + 
       3 $CellContext`m^2 Log[$CellContext`m^2 $CellContext`mu^(-2)]))],
