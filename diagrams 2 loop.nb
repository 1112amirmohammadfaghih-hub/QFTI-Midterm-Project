   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Critical exponent \[Eta] = 2 * \
\[Gamma]_\[Phi](g*):\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"etaExpr", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "/", "12"}], ")"}], "*", 
